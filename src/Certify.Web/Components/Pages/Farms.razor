@page "/farms"
@rendermode InteractiveServer
@inject CertifyApiClient Api

<PageTitle>Farms</PageTitle>

<h1>Farms</h1>

<div class="search">
    <input @bind="searchTerm" placeholder="Filter by country" />
    <button @onclick="SearchAsync">Search</button>
</div>

@if (_error is not null)
{
    <div class="status status-fail">
        <h2>Could not load farms</h2>
        <pre>@_error</pre>
    </div>
}
else if (_farms is null)
{
    <p>Loading…</p>
}
else
{
    <ul>
        @foreach (var farm in _farms)
        {
                <li>@farm.Name (@farm.Country)</li>
        }
    </ul>

}

<h2>Add a farm</h2>

<EditForm Model="_newFarm" OnValidSubmit="AddFarmAsync">
    <DataAnnotationsValidator/>
    <InputText @bind-Value="_newFarm.Name" placeholder="Name" />
    <ValidationMessage For="()=>_newFarm.Name"></ValidationMessage>
    <InputText @bind-Value="_newFarm.Country" placeholder="Country" />
    <ValidationMessage For="()=>_newFarm.Country"></ValidationMessage>

    @if (_addError is not null)
    {
        <p style="color:red" >@_addError</p>
    }

    <button type="submit">Add</button>
</EditForm>

@code {
    private List<FarmSummary>? _farms;
    private string? _error;
    private string searchTerm = "";
    private NewFarmDTO _newFarm = new();
    private string? _addError = null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _farms = await Api.GetFarmsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task SearchAsync()
    {
        _farms = await Api.GetFarmsAsync(searchTerm);
    }

    private async Task AddFarmAsync()
    {
        try
        {
            _addError = null;
            await Api.AddFarmAsync(_newFarm);
            _newFarm = new();
            _farms = await Api.GetFarmsAsync();

        }catch(Exception ex)
        {
            _addError = ex.Message;   
        }
    }
}
